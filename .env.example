# =============================================================================
# Chat Asistencia Psicológica — environment schema (PLACEHOLDERS ONLY).
# Copy to `.env` (git-ignored) and fill with real values. NEVER commit real
# secrets. Every variable is zod-validated at boot by packages/config — boot
# fails fast with a clear message when a required variable is missing.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# --- PostgreSQL 16 + pgvector ---
DATABASE_URL=postgres://chatcap:CHANGE_ME@localhost:5432/chatcap

# --- Redis 7 (pub-sub, OTP TTL, alert queues) ---
REDIS_URL=redis://localhost:6379

# --- OpenAI (never hardcoded; swap models via config only) ---
OPENAI_API_KEY=sk-CHANGE_ME
# Model swap is configuration-only (REQ-RAG-7): chat is always gpt-4o at
# temperature 0; NLI/classification and embeddings use the cheap models.
LLM_CHAT_MODEL=gpt-4o
LLM_NLI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Kill switch: false disables AI emission globally (bot degrades to human-only).
AI_EMISSION_ENABLED=true

# --- Crypto master material (min 32 chars) ---
# Key material is NEVER stored; per-version keys are derived via HKDF-SHA256
# from CRYPTO_MASTER_SECRET + per-version salt stored in key_versions.
CRYPTO_MASTER_SECRET=CHANGE_ME_min_32_chars_random
JWT_SECRET=CHANGE_ME_min_32_chars_random
QR_KEY=CHANGE_ME_min_32_chars_random

# --- Dashboard admin bootstrap ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=CHANGE_ME_bcrypt_hash

# --- Service-to-service auth (private Docker network) ---
X_INTERNAL_TOKENS=CHANGE_ME_token_a,CHANGE_ME_token_b

# --- Coherence gate thresholds (calibrated during verify) ---
GATE_COSINE_EMIT=0.85
GATE_COSINE_RETRY=0.75
GATE_MAX_RETRIES=1
GATE_NLI_ENABLED=true

# --- RAG tuning (ai-rag service) ---
# Top-k chunks retrieved per query by the RAG pipeline (default 5).
RAG_TOP_K=5

# --- Alert push throttle (seconds per severity) + fallback channel ---
# Repeat alerts within the window are throttled, not pushed again.
ALERT_THROTTLE_RED_SECONDS=60
ALERT_THROTTLE_ORANGE_SECONDS=300
ALERT_THROTTLE_YELLOW_SECONDS=900
# Fallback push endpoint (Telegram bot API or internal webhook) used when the
# Socket.io push cannot be confirmed. Empty = no fallback (REQ-ALERT-4).
FALLBACK_PUSH_URL=
# Allowed origin for the supervisor dashboard Socket.io connections.
# Empty = same-origin only (pilot serves dashboard + notifications behind the
# same Caddy TLS origin). Set e.g. https://dashboard.example.com when split.
DASHBOARD_ORIGIN=

# --- Geolocation (MaxMind/IPStack) ---
# provider: maxmind | ipstack | none (none = conservative default framework)
GEOIP_PROVIDER=none
MAXMIND_DB_PATH=
IPSTACK_API_KEY=

# --- chat-bot service (WhatsApp provider + jurisdiction onboarding) ---
# Provider: baileys | meta (swap is configuration-only, design §8).
CHATBOT_PROVIDER=baileys
# Baileys session directory (multi-auth state persistence). Required when
# CHATBOT_PROVIDER=baileys; empty in test/mock mode.
CHATBOT_BAILEYS_SESSION_DIR=
# Meta Cloud API credentials (required only when CHATBOT_PROVIDER=meta).
CHATBOT_META_ACCESS_TOKEN=
CHATBOT_META_PHONE_NUMBER_ID=
# ai-rag service base URL (internal Docker network).
CHATBOT_AI_RAG_BASE_URL=http://ai-rag:3000
# Must be one of the values in X_INTERNAL_TOKENS (cross-checked at boot).
CHATBOT_INTERNAL_TOKEN=CHANGE_ME_token_b
# Pepper for contact-key hashing (min 16 chars). Same value across restarts
# or keys change and sessions orphan. NEVER log or commit the real value.
CONTACT_KEY_SALT=CHANGE_ME_min_16_chars_random

# --- Dashboard service (phase 5, REQ-DASH-1/3) ---
# JWT access-token TTL for the supervisor dashboard (minutes). Design §3.3
# pilot default 15 min.
DASHBOARD_JWT_TTL_MINUTES=15
# chat-bot base URL over the private Docker network (dashboard → chat-bot
# takeover replies, POST /api/v1/messages/ingest).
DASHBOARD_CHATBOT_BASE_URL=http://chat-bot:3000
# Token presented to chat-bot's /messages/ingest; MUST be one of
# X_INTERNAL_TOKENS. Empty = ingest disabled (degraded mode).
DASHBOARD_CHATBOT_INTERNAL_TOKEN=CHANGE_ME_token_a
